{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "title": {
    "text": "Wargames and strategy games make up the biggest families",
    "subtitle": "Area = number of ranked games in each category (a game can be in two)",
    "anchor": "start",
    "subtitleFont": "Source Sans 3",
    "subtitleFontSize": 13,
    "subtitleColor": "#5f5a52",
    "offset": 12
  },
  "height": 420,
  "padding": 5,
  "data": [
    {
      "name": "tree",
      "url": "data/treemap_domains.csv",
      "format": {
        "type": "csv",
        "parse": {
          "games": "number",
          "avg_rating": "number",
          "avg_complexity": "number"
        }
      },
      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "games",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "round": true,
          "method": "squarify",
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ],
          "paddingInner": 3,
          "ratio": 1.3
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "!datum.children"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": [
        "Abstract Games",
        "Children's Games",
        "Customizable Games",
        "Family Games",
        "Party Games",
        "Strategy Games",
        "Thematic Games",
        "Wargames"
      ],
      "range": [
        "#4C78A8",
        "#F58518",
        "#E45756",
        "#72B7B2",
        "#54A24B",
        "#C9A227",
        "#B279A2",
        "#9D755D"
      ]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "enter": {
          "fill": {
            "scale": "color",
            "field": "id"
          },
          "stroke": {
            "value": "#fff"
          },
          "tooltip": {
            "signal": "{'Category': datum.id, 'Games': format(datum.games, ','), 'Average rating': datum.avg_rating, 'Average complexity': datum.avg_complexity}"
          }
        },
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fillOpacity": {
            "value": 0.9
          }
        },
        "hover": {
          "fillOpacity": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "interactive": false,
      "encode": {
        "enter": {
          "font": {
            "value": "Fredoka"
          },
          "fill": {
            "value": "#fff"
          },
          "align": {
            "value": "left"
          },
          "baseline": {
            "value": "top"
          }
        },
        "update": {
          "x": {
            "signal": "datum.x0 + 8"
          },
          "y": {
            "signal": "datum.y0 + 8"
          },
          "fontSize": {
            "signal": "max(10, min(14, (datum.x1 - datum.x0 - 14) / (0.6 * max(length(replace(datum.id, ' Games', '')), 10))))"
          },
          "text": {
            "signal": "[replace(datum.id,' Games',''), format(datum.games, ',') + ' games']"
          }
        }
      }
    }
  ],
  "config": {
    "title": {
      "font": "Fredoka",
      "fontSize": 17,
      "fontWeight": 600,
      "color": "#2b2b2b"
    },
    "text": {
      "font": "Source Sans 3"
    }
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "signals": [
    {
      "name": "width",
      "init": "max(containerSize()[0], 360)",
      "on": [
        {
          "events": "window:resize",
          "update": "max(containerSize()[0], 360)"
        }
      ]
    }
  ]
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The board game boom after 2010",
    "subtitle": "Ranked games released each year by category, 1980 to 2020. Click a category in the legend to highlight it"
  },
  "data": {
    "url": "data/games_per_year_domain.csv"
  },
  "width": "container",
  "height": 300,
  "params": [
    {
      "name": "dom",
      "select": {
        "type": "point",
        "fields": [
          "domain"
        ]
      },
      "bind": "legend"
    }
  ],
  "mark": {
    "type": "area",
    "interpolate": "monotone"
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": null,
      "axis": {
        "format": "d",
        "tickCount": 9,
        "grid": false
      }
    },
    "y": {
      "aggregate": "sum",
      "field": "games",
      "type": "quantitative",
      "stack": "center",
      "axis": null
    },
    "color": {
      "field": "domain",
      "type": "nominal",
      "title": "Category",
      "scale": {
        "domain": [
          "Abstract Games",
          "Children's Games",
          "Customizable Games",
          "Family Games",
          "Party Games",
          "Strategy Games",
          "Thematic Games",
          "Wargames"
        ],
        "range": [
          "#4C78A8",
          "#F58518",
          "#E45756",
          "#72B7B2",
          "#54A24B",
          "#C9A227",
          "#B279A2",
          "#9D755D"
        ]
      }
    },
    "opacity": {
      "condition": {
        "param": "dom",
        "value": 1
      },
      "value": 0.15
    },
    "tooltip": [
      {
        "field": "domain",
        "title": "Category"
      },
      {
        "field": "year",
        "title": "Year"
      },
      {
        "field": "games",
        "title": "Games released"
      }
    ]
  },
  "config": {
    "font": "Source Sans 3",
    "title": {
      "font": "Fredoka",
      "fontSize": 17,
      "fontWeight": 600,
      "anchor": "start",
      "color": "#2b2b2b",
      "subtitleFont": "Source Sans 3",
      "subtitleFontSize": 13,
      "subtitleFontWeight": "normal",
      "subtitleColor": "#5f5a52",
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#555",
      "labelColor": "#555",
      "gridColor": "#eee",
      "domainColor": "#bbb"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "view": {
      "stroke": null
    }
  }
}
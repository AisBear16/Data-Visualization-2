{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "title": {
    "text": "Who spends the most importing games?",
    "subtitle": [
      "Each circle is a country, sized by its 2023 imports of board and table games (US$).",
      "Circles sit near their country and push apart so they don't overlap. Hover for names of small circles"
    ],
    "anchor": "start",
    "subtitleFont": "Source Sans 3",
    "subtitleFontSize": 13,
    "subtitleColor": "#5f5a52",
    "offset": 12
  },
  "width": 900,
  "height": 460,
  "padding": 5,
  "autosize": "pad",
  "signals": [
    {
      "name": "maxR",
      "value": 70
    }
  ],
  "projections": [
    {
      "name": "projection",
      "type": "equalEarth",
      "fit": {
        "signal": "{type: 'Sphere'}"
      },
      "size": [
        {
          "signal": "width"
        },
        {
          "signal": "height"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "world",
      "url": "js/ne_110m_admin_0_countries.topojson",
      "format": {
        "type": "topojson",
        "feature": "ne_110m_admin_0_countries"
      }
    },
    {
      "name": "imports",
      "url": "data/game_imports_2023.csv",
      "format": {
        "type": "csv",
        "parse": {
          "import_musd": "number",
          "lon": "number",
          "lat": "number"
        }
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.import_musd >= 5"
        },
        {
          "type": "formula",
          "as": "xy",
          "expr": "scale('projection', [datum.lon, datum.lat])"
        },
        {
          "type": "formula",
          "as": "cx",
          "expr": "datum.xy[0]"
        },
        {
          "type": "formula",
          "as": "cy",
          "expr": "datum.xy[1]"
        },
        {
          "type": "formula",
          "as": "r",
          "expr": "scale('size', datum.import_musd)"
        },
        {
          "type": "formula",
          "as": "lines",
          "expr": "datum.country == 'United States of America' ? ['United', 'States'] : datum.country == 'Netherlands' ? ['Nether-', 'lands'] : split(datum.country, ' ')"
        },
        {
          "type": "formula",
          "as": "maxlen",
          "expr": "max(length(datum.lines[0]), datum.lines.length > 1 ? length(datum.lines[1]) : 0, datum.lines.length > 2 ? length(datum.lines[2]) : 0)"
        },
        {
          "type": "formula",
          "as": "fs",
          "expr": "min(datum.r / 2.1, 1.7 * datum.r / (0.5 * datum.maxlen), 1.5 * datum.r / (1.15 * datum.lines.length))"
        },
        {
          "type": "force",
          "static": true,
          "iterations": 300,
          "forces": [
            {
              "force": "collide",
              "radius": {
                "expr": "datum.r + 1"
              }
            },
            {
              "force": "x",
              "x": "cx",
              "strength": 0.2
            },
            {
              "force": "y",
              "y": "cy",
              "strength": 0.2
            }
          ]
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "size",
      "type": "sqrt",
      "domain": [
        0,
        12200
      ],
      "range": [
        0,
        {
          "signal": "maxR"
        }
      ],
      "zero": true
    },
    {
      "name": "color",
      "type": "ordinal",
      "domain": [
        "North America",
        "Europe",
        "Asia",
        "South America",
        "Oceania",
        "Africa"
      ],
      "range": [
        "#1f78b4",
        "#ff7f00",
        "#6a3d9a",
        "#a6cee3",
        "#fdbf6f",
        "#cab2d6"
      ]
    }
  ],
  "legends": [
    {
      "fill": "color",
      "title": "Continent",
      "orient": "left",
      "direction": "vertical",
      "labelFont": "Source Sans 3",
      "titleFont": "Source Sans 3"
    }
  ],
  "marks": [
    {
      "type": "shape",
      "from": {
        "data": "world"
      },
      "encode": {
        "enter": {
          "fill": {
            "value": "#efe9de"
          },
          "stroke": {
            "value": "#ffffff"
          },
          "strokeWidth": {
            "value": 0.5
          }
        }
      },
      "transform": [
        {
          "type": "geoshape",
          "projection": "projection"
        }
      ]
    },
    {
      "type": "symbol",
      "name": "bubbles",
      "from": {
        "data": "imports"
      },
      "encode": {
        "enter": {
          "shape": {
            "value": "circle"
          },
          "fill": {
            "scale": "color",
            "field": "continent"
          },
          "stroke": {
            "value": "#ffffff"
          },
          "strokeWidth": {
            "value": 1
          },
          "tooltip": {
            "signal": "{'Country': datum.country, 'Imports 2023 (US$ million)': format(datum.import_musd, ',.1f')}"
          }
        },
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "size": {
            "signal": "4 * datum.r * datum.r"
          },
          "fillOpacity": {
            "value": 0.85
          }
        },
        "hover": {
          "fillOpacity": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "imports"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "text": {
            "signal": "datum.fs >= 8 ? datum.lines : ''"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "fill": {
            "value": "#ffffff"
          },
          "font": {
            "value": "Fredoka"
          },
          "fontSize": {
            "signal": "datum.fs"
          },
          "lineHeight": {
            "signal": "datum.fs * 1.1"
          },
          "dy": {
            "signal": "-(datum.lines.length - 1) * datum.fs * 0.55"
          }
        }
      }
    }
  ],
  "config": {
    "title": {
      "font": "Fredoka",
      "fontSize": 17,
      "fontWeight": 600,
      "color": "#2b2b2b"
    }
  }
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Complexity vs rating in each category",
    "subtitle": "Each dot is a game. Hover for its name"
  },
  "data": {
    "url": "data/games_by_domain.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "avg_rating_2025": "number",
        "complexity_2021": "number",
        "voters_2025": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "isValid(datum.complexity_2021) && datum.voters_2025 >= 100"
    }
  ],
  "facet": {
    "field": "domain",
    "type": "nominal",
    "title": null,
    "header": {
      "labelFont": "Fredoka",
      "labelFontSize": 13
    }
  },
  "columns": 4,
  "spec": {
    "width": 190,
    "height": 150,
    "mark": {
      "type": "circle",
      "size": 10,
      "opacity": 0.35
    },
    "encoding": {
      "x": {
        "field": "complexity_2021",
        "type": "quantitative",
        "title": "Complexity",
        "scale": {
          "domain": [
            1,
            5
          ]
        }
      },
      "y": {
        "field": "avg_rating_2025",
        "type": "quantitative",
        "title": "Rating",
        "scale": {
          "domain": [
            3,
            10
          ]
        }
      },
      "color": {
        "field": "domain",
        "type": "nominal",
        "scale": {
          "domain": [
            "Abstract Games",
            "Children's Games",
            "Customizable Games",
            "Family Games",
            "Party Games",
            "Strategy Games",
            "Thematic Games",
            "Wargames"
          ],
          "range": [
            "#4C78A8",
            "#F58518",
            "#E45756",
            "#72B7B2",
            "#54A24B",
            "#C9A227",
            "#B279A2",
            "#9D755D"
          ]
        },
        "legend": null
      },
      "tooltip": [
        {
          "field": "title",
          "title": "Game"
        },
        {
          "field": "year",
          "title": "Year"
        },
        {
          "field": "complexity_2021",
          "title": "Complexity"
        },
        {
          "field": "avg_rating_2025",
          "title": "Rating"
        }
      ]
    }
  },
  "config": {
    "font": "Source Sans 3",
    "title": {
      "font": "Fredoka",
      "fontSize": 17,
      "fontWeight": 600,
      "anchor": "start",
      "color": "#2b2b2b",
      "subtitleFont": "Source Sans 3",
      "subtitleFontSize": 13,
      "subtitleFontWeight": "normal",
      "subtitleColor": "#5f5a52",
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#555",
      "labelColor": "#555",
      "gridColor": "#eee",
      "domainColor": "#bbb"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "view": {
      "stroke": null
    }
  }
}
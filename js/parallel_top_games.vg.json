{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "What do the top 25 games have in common?",
    "subtitle": "Each line is one of BoardGameGeek's 25 highest-ranked games. Axes are scaled from lowest to highest among these games"
  },
  "data": {
    "url": "data/games.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "rank_2025": "number",
        "avg_rating_2025": "number",
        "voters_2025": "number",
        "complexity_2021": "number",
        "play_time": "number",
        "min_age": "number",
        "owned_2021": "number"
      }
    }
  },
  "width": "container",
  "height": 320,
  "transform": [
    {
      "filter": "isValid(datum.rank_2025) && datum.rank_2025 <= 25"
    },
    {
      "calculate": "datum.avg_rating_2025",
      "as": "Rating"
    },
    {
      "calculate": "datum.complexity_2021",
      "as": "Complexity"
    },
    {
      "calculate": "datum.play_time",
      "as": "Play time (min)"
    },
    {
      "calculate": "datum.min_age",
      "as": "Minimum age"
    },
    {
      "calculate": "datum.owned_2021",
      "as": "Owners"
    },
    {
      "window": [
        {
          "op": "count",
          "as": "index"
        }
      ]
    },
    {
      "fold": [
        "Rating",
        "Complexity",
        "Play time (min)",
        "Minimum age",
        "Owners"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "min",
          "field": "value",
          "as": "min"
        },
        {
          "op": "max",
          "field": "value",
          "as": "max"
        }
      ],
      "groupby": [
        "key"
      ]
    },
    {
      "calculate": "(datum.value - datum.min) / (datum.max - datum.min)",
      "as": "norm"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#ccc"
      },
      "encoding": {
        "detail": {
          "aggregate": "count"
        },
        "x": {
          "field": "key",
          "type": "nominal",
          "sort": [
            "Rating",
            "Complexity",
            "Play time (min)",
            "Minimum age",
            "Owners"
          ]
        }
      }
    },
    {
      "params": [
        {
          "name": "hl",
          "select": {
            "type": "point",
            "fields": [
              "title"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 2.5
      },
      "encoding": {
        "color": {
          "field": "domain",
          "type": "nominal",
          "scale": {
            "domain": [
              "Abstract Games",
              "Children's Games",
              "Customizable Games",
              "Family Games",
              "Party Games",
              "Strategy Games",
              "Thematic Games",
              "Wargames"
            ],
            "range": [
              "#4C78A8",
              "#F58518",
              "#E45756",
              "#72B7B2",
              "#54A24B",
              "#C9A227",
              "#B279A2",
              "#9D755D"
            ]
          },
          "title": "Category"
        },
        "detail": {
          "field": "index",
          "type": "nominal"
        },
        "opacity": {
          "condition": {
            "param": "hl",
            "empty": false,
            "value": 1
          },
          "value": 0.35
        },
        "x": {
          "field": "key",
          "type": "nominal",
          "sort": [
            "Rating",
            "Complexity",
            "Play time (min)",
            "Minimum age",
            "Owners"
          ]
        },
        "y": {
          "field": "norm",
          "type": "quantitative",
          "axis": null
        },
        "tooltip": [
          {
            "field": "title",
            "title": "Game"
          },
          {
            "field": "rank_2025",
            "title": "Rank"
          },
          {
            "field": "Rating"
          },
          {
            "field": "Complexity"
          },
          {
            "field": "Play time (min)"
          },
          {
            "field": "Minimum age"
          },
          {
            "field": "Owners",
            "format": ","
          }
        ]
      }
    },
    {
      "encoding": {
        "x": {
          "field": "key",
          "type": "nominal",
          "sort": [
            "Rating",
            "Complexity",
            "Play time (min)",
            "Minimum age",
            "Owners"
          ]
        },
        "y": {
          "value": 0
        }
      },
      "layer": [
        {
          "mark": {
            "type": "text",
            "style": "label"
          },
          "encoding": {
            "text": {
              "aggregate": "max",
              "field": "max"
            }
          }
        },
        {
          "mark": {
            "type": "tick",
            "style": "tick",
            "size": 8,
            "color": "#ccc"
          }
        }
      ]
    },
    {
      "encoding": {
        "x": {
          "field": "key",
          "type": "nominal",
          "sort": [
            "Rating",
            "Complexity",
            "Play time (min)",
            "Minimum age",
            "Owners"
          ]
        },
        "y": {
          "value": 320
        }
      },
      "layer": [
        {
          "mark": {
            "type": "text",
            "style": "label"
          },
          "encoding": {
            "text": {
              "aggregate": "min",
              "field": "min"
            }
          }
        },
        {
          "mark": {
            "type": "tick",
            "style": "tick",
            "size": 8,
            "color": "#ccc"
          }
        }
      ]
    }
  ],
  "config": {
    "font": "Source Sans 3",
    "title": {
      "font": "Fredoka",
      "fontSize": 17,
      "fontWeight": 600,
      "anchor": "start",
      "color": "#2b2b2b",
      "subtitleFont": "Source Sans 3",
      "subtitleFontSize": 13,
      "subtitleFontWeight": "normal",
      "subtitleColor": "#5f5a52",
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#555",
      "labelColor": "#555",
      "gridColor": "#eee",
      "domainColor": "#bbb"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "view": {
      "stroke": null
    },
    "axisX": {
      "domain": false,
      "labelAngle": 0,
      "tickColor": "#ccc",
      "title": null,
      "labelFont": "Fredoka",
      "labelFontSize": 13
    },
    "style": {
      "label": {
        "baseline": "middle",
        "align": "right",
        "dx": -5
      },
      "tick": {
        "orient": "horizontal"
      }
    }
  }
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Board gamers per 100,000 people",
    "subtitle": "BoardGameGeek members divided by population. Grey = no members listed"
  },
  "width": "container",
  "height": 420,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f7f4ee",
        "stroke": "#d8d0c0"
      }
    },
    {
      "data": {
        "graticule": {
          "step": [
            30,
            30
          ]
        }
      },
      "mark": {
        "type": "geoshape",
        "stroke": "#e3dccd",
        "strokeWidth": 0.5,
        "fill": null
      }
    },
    {
      "data": {
        "url": "js/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.CONTINENT != 'Antarctica'"
        },
        {
          "lookup": "properties.NAME",
          "from": {
            "data": {
              "url": "data/bgg_users_by_country.csv"
            },
            "key": "country",
            "fields": [
              "per100k",
              "bgg_users"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#fff",
        "strokeWidth": 0.5
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.per100k == null",
            "value": "#d9d9d9"
          },
          "field": "per100k",
          "type": "quantitative",
          "title": "Members per 100k",
          "scale": {
            "type": "threshold",
            "domain": [
              1,
              5,
              10,
              25,
              50
            ],
            "range": [
              "#fdecd2",
              "#fcc98a",
              "#f9a04b",
              "#e36d22",
              "#b8410d",
              "#7a2804"
            ]
          }
        },
        "tooltip": [
          {
            "field": "properties.NAME",
            "title": "Country"
          },
          {
            "field": "per100k",
            "title": "Members per 100,000",
            "format": ".1f"
          },
          {
            "field": "bgg_users",
            "title": "Members",
            "format": ","
          }
        ]
      }
    }
  ],
  "config": {
    "font": "Source Sans 3",
    "title": {
      "font": "Fredoka",
      "fontSize": 17,
      "fontWeight": 600,
      "anchor": "start",
      "color": "#2b2b2b",
      "subtitleFont": "Source Sans 3",
      "subtitleFontSize": 13,
      "subtitleFontWeight": "normal",
      "subtitleColor": "#5f5a52",
      "offset": 12
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#555",
      "labelColor": "#555",
      "gridColor": "#eee",
      "domainColor": "#bbb"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "view": {
      "stroke": null
    }
  }
}
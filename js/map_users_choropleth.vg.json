{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Board gamers per 100,000 people",
    "subtitle": "BoardGameGeek members divided by population. Grey = no members listed"
  },
  "width": "container",
  "height": 420,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#d4e6f1",
        "stroke": "#9fbfd4"
      }
    },
    {
      "data": {
        "graticule": {
          "step": [
            30,
            30
          ]
        }
      },
      "mark": {
        "type": "geoshape",
        "stroke": "#b3cde0",
        "strokeWidth": 0.6,
        "fill": null
      }
    },
    {
      "data": {
        "url": "js/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.CONTINENT != 'Antarctica'"
        },
        {
          "lookup": "properties.NAME",
          "from": {
            "data": {
              "url": "data/bgg_users_by_country.csv"
            },
            "key": "country",
            "fields": [
              "per100k",
              "bgg_users"
            ]
          }
        },
        {
          "calculate": "datum.per100k == null ? 'No members listed' : datum.per100k < 1 ? 'Under 1' : datum.per100k < 5 ? '1 to 5' : datum.per100k < 10 ? '5 to 10' : datum.per100k < 25 ? '10 to 25' : datum.per100k < 50 ? '25 to 50' : '50 or more'",
          "as": "band"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      },
      "encoding": {
        "color": {
          "field": "band",
          "type": "ordinal",
          "title": "Per 100,000 people",
          "scale": {
            "domain": [
              "No members listed",
              "Under 1",
              "1 to 5",
              "5 to 10",
              "10 to 25",
              "25 to 50",
              "50 or more"
            ],
            "range": [
              "#a3a3a3",
              "#fee6c7",
              "#fdc086",
              "#f9a04b",
              "#e36d22",
              "#b8410d",
              "#7a2804"
            ]
          },
          "legend": {
            "symbolType": "square",
            "symbolSize": 200
          }
        },
        "tooltip": [
          {
            "field": "properties.NAME",
            "title": "Country"
          },
          {
            "field": "per100k",
            "title": "Members per 100,000",
            "format": ".1f"
          },
          {
            "field": "bgg_users",
            "title": "Members",
            "format": ","
          }
        ]
      }
    },
